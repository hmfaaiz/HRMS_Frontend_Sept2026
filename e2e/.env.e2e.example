# Copy to e2e/.env.e2e and fill in. Never commit the real file.
#
# Use a dedicated, low-privilege test account. Prefer one whose User row has
# authType != 2, so the suite doesn't have to answer an OTP challenge.
E2E_EMAIL=
E2E_PASSWORD=

# Optional overrides. Defaults match HRMS_Frontend/.env:
#   PORT=3002, REACT_APP_API_URL=http://localhost:3001/apis
# E2E_BASE_URL=http://localhost:3002
# E2E_API_URL=http://localhost:3001/apis
